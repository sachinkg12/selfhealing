# LLM provider keys. The reference implementation uses ANTHROPIC_API_KEY by
# default. The others are kept here so alternative ChatClient beans can be
# wired in without changing the env contract.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
OPENAI_API_KEY=sk-proj-REPLACE_ME
GROQ_API_KEY=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
TOGETHER_API_KEY=REPLACE_ME

# Slack incoming webhook for the Notification MCP server.
# Optional — leave blank to use the no-op Slack stub at the boundary.
SLACK_WEBHOOK_URL=

# Local OAuth issuer (Spring Authorization Server runs in-process; these are
# the seeded client credentials used by the agent to mint approval tokens).
OAUTH_ISSUER_URI=http://localhost:9000
OAUTH_CLIENT_ID=selfhealing-agent
OAUTH_CLIENT_SECRET=demo-secret-not-for-production
